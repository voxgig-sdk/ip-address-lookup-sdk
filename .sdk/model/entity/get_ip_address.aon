# Entity: get_ip_address

main: kit: entity: get_ip_address: {

  alias: field: {}

  fields: [
    {
      name: "asn"
      req: false
      short: "Autonomous System Number"
      type: "`$STRING`"
    }
    {
      name: "isp"
      req: false
      short: "Internet Service Provider"
      type: "`$STRING`"
    }
    {
      name: "organization"
      req: false
      short: "Organization owning the IP range"
      type: "`$STRING`"
    }
  ]

  name: "get_ip_address"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/"
          transform: {
            req: "`reqdata`"
            res: "`body.network`"
          }
        }
      ]
    }
  }



}
